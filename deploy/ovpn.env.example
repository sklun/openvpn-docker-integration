#!/bin/bash
# 功能说明：提供初始化与运行时共用、可由 Bash 直接加载的环境变量配置示例。
# shellcheck disable=SC2034

# 路径与镜像
# OpenVPN 数据目录在容器内的挂载路径。OTP 或固定密码认证依赖该默认路径，
# 如无明确的配套修改，请保持为 /etc/openvpn。
OPENVPN="/etc/openvpn"
# 部署时使用的镜像名称和标签，需与 server/build.sh 的构建结果一致。
OVPN_IMAGE="openvpn-integration:local"

# 网络
# 客户端访问的公网域名或 IP，同时用于生成服务端证书。
OVPN_HOST="vpn.example.com"
# 宿主机监听端口；容器内 OpenVPN 始终监听 1194。
OVPN_PORT="1194"
# 分配给 VPN 客户端的地址池，使用 CIDR 格式，前缀长度支持 1-29。
OVPN_CLIENT_SUBNET="10.8.0.0/24"
# true 时仅向客户端下发默认路由，使全部流量经过 VPN；不会隐式启用 NAT。
OVPN_DEFROUTE=false
# true 时将 VPN 客户端源地址转换为 VPN Server 的出口地址，通常无需目的网络配置回程路由。
# false 时目的端可看到客户端的隧道 IP，但目的网络及 Docker 主机必须具备到
# OVPN_CLIENT_SUBNET 的回程路由。该开关无法让目的端看到客户端接入 VPN 前的公网 IP。
OVPN_NAT=true
# MASQUERADE 使用的容器出口网卡；默认 Compose bridge 网络中通常为 eth0。
OVPN_NATDEVICE="eth0"
# 可选的 tun-mtu 值；留空时使用 OpenVPN 默认值。
OVPN_MTU=""
# 可选的 tls-cipher 值；留空时使用 OpenVPN 默认值。
OVPN_TLS_CIPHER=""
# 下发给客户端的 DNS 地址，例如：OVPN_DNS_SERVERS=("1.1.1.1" "8.8.8.8")。
OVPN_DNS_SERVERS=()
# 额外下发的 CIDR 路由，例如：OVPN_ROUTES=("10.20.0.0/16" "172.16.1.0/24")。
OVPN_ROUTES=()
# 额外 push 指令，每个数组元素是一条指令，例如：OVPN_PUSH=("dhcp-option DOMAIN example.com")。
OVPN_PUSH=()

# 认证
# true 时创建无密码 CA，便于自动化；生产环境应结合私钥保护策略评估风险。
CA_NOPASS=true
# 认证模式互斥关系：LDAP 不能与 OTP/PASSWORD_AUTH 同时启用；OTP 与 PASSWORD_AUTH
# 可同时启用，此时用户可使用动态口令或预置固定密码。
# 启用 TOTP 动态口令认证。
OTP=true
# 启用预置固定密码认证。
PASSWORD_AUTH=false
# 非 LDAP 用户证书名的环境后缀；留空时使用部署环境名。仅在运行目录名与既有
# 证书后缀不同的迁移场景中设置，例如运行目录 ali-re 继续管理 *-ali 证书。
OVPN_USER_SUFFIX=""
# 启用 LDAP 用户名密码认证。
LDAP=false
# LDAP 插件配置文件路径，由初始化脚本根据下列 LDAP_* 变量生成。
LDAP_CONF="${OPENVPN}/auth/ldap.conf"
# true 时客户端证书为可选，允许仅凭用户名密码认证；false 时仍要求有效客户端证书。
LDAP_DISABLE_CERT_VERIFY=true
# LDAP 服务地址，填写 host:port；当前配置生成器使用 ldap:// 连接。
LDAP_URL=""
# LDAP 查询账号 DN。
LDAP_BIND_DN=""
# LDAP 查询账号密码。
LDAP_PASSWORD=""
# 用户查询的基础 DN。
LDAP_BASE_DN=""
# 用户查询过滤器，%u 会替换为登录用户名。
LDAP_SEARCHFILTER="(cn=%u)"
# LDAP 用户授权策略文件；用于限制用户可访问的目标网段。
LDAP_AUTHZ_FILE="${OPENVPN}/auth/vpn_user.json"
# 可选的 tls-auth HMAC 摘要算法，例如 SHA256；留空时使用 OpenVPN 默认值。
OVPN_AUTH=""

# 访问策略与生命周期钩子
# true 时按客户端配置或 LDAP_AUTHZ_FILE 对所有 VPN 转发目标应用每用户 iptables 白名单。
IPTABLES_POLICY=true
# iptables 后端：auto 自动探测并保持已选后端，nft 或 legacy 强制指定。
# legacy 同时兼容显式 iptables-legacy 与旧系统中无后端标记的经典 iptables。
OVPN_IPTABLES_BACKEND="auto"
# true 时校验客户端上报的设备信息；需要配套的兼容客户端。
DEVICE_AUTH=false
# true 时启动时自动吊销超过指定月数的客户端证书。
AUTO_REVOKE=false
# 自动吊销判定的证书存续月数，仅在 AUTO_REVOKE=true 时生效。
AUTO_REVOKE_MONTHS=3

# OpenVPN 基础配置
# 传输协议：udp、udp6、tcp 或 tcp6。
OVPN_PROTO="udp"
# 数据通道加密算法。
OVPN_CIPHER="AES-256-CBC"
# 虚拟网络设备类型，通常使用 tun；二层桥接场景可使用 tap。
OVPN_DEVICE="tun"
# keepalive 参数，依次为 ping 间隔和超时秒数。
OVPN_KEEPALIVE="10 60"
# 可选的管理接口地址和端口，例如 "127.0.0.1 2080"；留空表示禁用。
OVPN_MANAGEMENT=""
# 管理接口密码文件；启用管理接口时需确保该文件存在且权限受控。
OVPN_MANAGEMENT_PASS="${OPENVPN}/auth/.management-pass"

# PKI
# Easy-RSA PKI 数据目录。
EASYRSA_PKI="${OPENVPN}/pki"
# Easy-RSA 程序目录。
EASYRSA="/usr/share/easy-rsa"
# 证书吊销列表有效期，单位为天。
EASYRSA_CRL_DAYS=3650
# 新签发证书的默认有效期，单位为天。
EASYRSA_CERT_EXPIRE=3650

# 日志
# OpenVPN 日志详细级别，常用值为 3；数值越高输出越详细。
LOG_VERB=3
# 日志目录。
LOG_PATH="${OPENVPN}/logs"
# OpenVPN 主日志文件。
OVPN_LOG_PATH="${LOG_PATH}/openvpn.log"
# OpenVPN 客户端连接状态日志。
OVPN_STATUS_LOG_PATH="${LOG_PATH}/openvpn-status.log"
# 日志保留天数。
LOG_RETAIN_DAYS=90
# 日志目录允许使用的磁盘空间百分比上限。
LOG_DISK_LIMIT=90

# 钩子与附加 OpenVPN 指令
# OpenVPN 运行时 hook 目录。
OVPN_HOOKS_PATH="${OPENVPN}/hooks"
# 追加到服务端配置的原始指令，每个数组元素一条，例如：EXTRA_CONF=("client-to-client")。
EXTRA_CONF=()

# 以下值由 install.sh 根据 OVPN_CLIENT_SUBNET 计算并写入运行时副本，请勿手工设置。
SUBNET_IP_FIRST=""
SUBNET_IP_LAST=""
