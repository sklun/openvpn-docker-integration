#!/bin/bash
# shellcheck disable=SC2034
# 配置说明见 docs/configuration.md；本文件会被 Bash source，不是通用 dotenv 文件。

# 路径与镜像
OPENVPN="/etc/openvpn"
OVPN_IMAGE="openvpn-integration:local"

# 网络
OVPN_HOST="vpn.example.com"
OVPN_PORT="1194"
OVPN_CLIENT_SUBNET="10.8.0.0/24"
OVPN_DEFROUTE=false
OVPN_NAT=true
OVPN_NATDEVICE="eth0"
OVPN_MTU=""
OVPN_TLS_CIPHER=""
OVPN_DNS_SERVERS=()
OVPN_ROUTES=()
OVPN_PUSH=()

# 认证
CA_NOPASS=true
OTP=true
PASSWORD_AUTH=false
OVPN_USER_SUFFIX=""
LDAP=false
LDAP_CONF="${OPENVPN}/auth/ldap.conf"
LDAP_DISABLE_CERT_VERIFY=true
LDAP_URL=""
LDAP_BIND_DN=""
LDAP_PASSWORD=""
LDAP_BASE_DN=""
LDAP_SEARCHFILTER="(cn=%u)"
LDAP_AUTHZ_FILE="${OPENVPN}/auth/vpn_user.json"
OVPN_AUTH=""

# 访问策略与生命周期
IPTABLES_POLICY=true
# 留空时首次启动自动探测，并写回 nft 或 legacy。
OVPN_IPTABLES_BACKEND=""
DEVICE_AUTH=false
AUTO_REVOKE=false
AUTO_REVOKE_MONTHS=3

# OpenVPN
OVPN_PROTO="udp"
OVPN_CIPHER="AES-256-CBC"
OVPN_DEVICE="tun"
OVPN_KEEPALIVE="10 60"
OVPN_MANAGEMENT=""
OVPN_MANAGEMENT_PASS="${OPENVPN}/auth/.management-pass"

# PKI
EASYRSA_PKI="${OPENVPN}/pki"
EASYRSA="/usr/share/easy-rsa"
EASYRSA_CRL_DAYS=3650
EASYRSA_CERT_EXPIRE=3650

# 日志
LOG_VERB=3
LOG_PATH="${OPENVPN}/logs"
OVPN_LOG_PATH="${LOG_PATH}/openvpn.log"
OVPN_STATUS_LOG_PATH="${LOG_PATH}/openvpn-status.log"
LOG_RETAIN_DAYS=90
LOG_DISK_LIMIT=90

# 钩子与附加指令
OVPN_HOOKS_PATH="${OPENVPN}/hooks"
EXTRA_CONF=()

# 由 install.sh 写入运行时副本，请勿设置。
SUBNET_IP_FIRST=""
SUBNET_IP_LAST=""
