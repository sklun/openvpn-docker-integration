	reset_otp
	;;
addpassuser | -apu)
	load_env
	add_password_user
	;;
delpassuser | -dpu)
	load_env
	delete_password_user
	;;
chpassuser | -cpu)
	load_env
	change_password_user
	;;
listpassuser | -lpu)
	load_env
	list_password_users
	;;
listroute | -lr)
	load_env
	list_routes
	;;
addroute | -ar)
	load_env
	normalize_route "$ARGUMENT"
	add_route_for_user "$USER_INPUT"
	;;
delroute | -dr)
	load_env
	normalize_route "$ARGUMENT"
	delete_route_for_user "$USER_INPUT"
	;;
adddomainroute | -adr)
	load_env
	add_domain_routes
	;;
addrouteall | -ara)
	load_env
	route_all add
	;;
delrouteall | -dra)
	load_env
	route_all delete
	;;
listhwaddr | -lh)
	load_env
	list_hardware
	;;
delhwaddr | -dh)
	load_env
	delete_hardware
	;;
start)
	load_env
	start_service
	;;
stop)
	load_env
	stop_service
	;;
restart)
	load_env
	restart_service
	;;
status)
	load_env
	show_status
	;;
reloadiptables)
	load_env
	reload_iptables
	;;
reloadipset)
	load_env
	reload_ipset
	;;
backuphostnetwork)
	load_env
	backup_host_network
	;;
*)
	usage
	fail "未知命令: $COMMAND"
	;;
esac
