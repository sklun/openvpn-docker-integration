# 读取并校验命令参数或交互输入的固定密码。
read_password() {
	local value=${ARGUMENT:-}
	if [[ -z $value ]]; then
		[[ -t 0 ]] || fail "非交互执行时必须提供密码参数"
		read -r -s -p "Password: " value
		echo
	fi
	[[ -n $value ]] || fail "密码不能为空"
	[[ $value != *:* && $value != *$'\n'* && $value != *$'\r'* ]] || fail "密码包含不支持的字符"
	PASSWORD_VALUE=$value
}

# 为现有证书用户添加固定密码认证凭据。
add_password_user() {
	normalize_user "$USER_INPUT"
	is_true "${PASSWORD_AUTH:-false}" || fail "当前环境未启用固定密码认证"
	[[ -f $CLIENT_CERT ]] || fail "VPN 用户不存在: $CLIENT_NAME"
	log_start "添加固定密码用户: ${CLIENT_NAME}（环境: ${ENV_NAME}）"
	read_password
	secure_file "$PASSWORD_USERS_FILE"
	secure_file "$PASSWORD_FILE"
	exec 201>"$LOCAL_PATH/auth/.static-password.lock"
	flock -w 10 201 || fail "无法锁定固定密码状态文件"
	grep -Fxq "$CLIENT_NAME" "$PASSWORD_USERS_FILE" && fail "固定密码用户已存在: $CLIENT_NAME"
	printf '%s\n' "$CLIENT_NAME" >>"$PASSWORD_USERS_FILE"
	printf '%s:%s\n' "$CLIENT_NAME" "$PASSWORD_VALUE" >>"$PASSWORD_FILE"
	secure_file "$PASSWORD_USERS_FILE"
	secure_file "$PASSWORD_FILE"
	flock -u 201
	log_success "固定密码用户添加完成: $CLIENT_NAME"
}

# 删除用户的固定密码认证凭据。
delete_password_user() {
	normalize_user "$USER_INPUT"
	grep -Fxq "$CLIENT_NAME" "$PASSWORD_USERS_FILE" || fail "固定密码用户不存在: $CLIENT_NAME"
	log_start "删除固定密码用户: ${CLIENT_NAME}（环境: ${ENV_NAME}）"
	exec 201>"$LOCAL_PATH/auth/.static-password.lock"
	flock -w 10 201 || fail "无法锁定固定密码状态文件"
	remove_password_user "$CLIENT_NAME"
	flock -u 201
	log_success "固定密码用户删除完成: $CLIENT_NAME"
}

# 原子更新固定密码用户的密码。
change_password_user() {
	normalize_user "$USER_INPUT"
	grep -Fxq "$CLIENT_NAME" "$PASSWORD_USERS_FILE" || fail "固定密码用户不存在: $CLIENT_NAME"
	log_start "修改固定密码用户密码: ${CLIENT_NAME}（环境: ${ENV_NAME}）"
	read_password
	exec 201>"$LOCAL_PATH/auth/.static-password.lock"
	flock -w 10 201 || fail "无法锁定固定密码状态文件"
	temp=$(mktemp "${PASSWORD_FILE}.XXXXXX")
	awk -F: -v user="$CLIENT_NAME" -v password="$PASSWORD_VALUE" \
		'$1 == user { print user ":" password; updated = 1; next } { print } END { if (!updated) print user ":" password }' \
		"$PASSWORD_FILE" >"$temp"
	mv "$temp" "$PASSWORD_FILE"
	secure_file "$PASSWORD_FILE"
	flock -u 201
	log_success "固定密码修改完成: $CLIENT_NAME"
}

# 列出固定密码用户名且不暴露密码内容。
list_password_users() {
	log_info "列出环境 $ENV_NAME 的固定密码用户（不显示密码）"
