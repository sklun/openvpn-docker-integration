# 校验并规范化路由，生成 CIDR、掩码和 CCD 配置行。
normalize_route() {
	local route=$1
	[[ -n $route ]] || fail "缺少路由参数"
	valid_cidr "$route" || fail "路由格式不正确: $route"
	ROUTE_IP=${route%/*}
	if [[ $route == */* ]]; then ROUTE_PREFIX=${route#*/}; else ROUTE_PREFIX=32; fi
	ROUTE_CIDR="$ROUTE_IP/$ROUTE_PREFIX"
	ROUTE_MASK=$(cidr_to_mask "$ROUTE_PREFIX")
	ROUTE_LINE="push \"route $ROUTE_IP $ROUTE_MASK\""
}

# 为指定用户添加 CCD 路由和运行时 ipset 规则。
add_route_for_user() {
	local user=$1
	normalize_user "$user"
	[[ -f $CLIENT_CCD ]] || fail "找不到用户 CCD: $CLIENT_NAME"
	log_info "为用户 $CLIENT_NAME 添加路由: $ROUTE_CIDR"
	if ! grep -Fxq "$ROUTE_LINE" "$CLIENT_CCD"; then
		printf '%s\n' "$ROUTE_LINE" >>"$CLIENT_CCD"
	else
		log_info "CCD 中已存在该路由，跳过重复写入"
	fi
	require_running
	docker exec "$CONTAINER_NAME" ipset add "$IPSET_NAME" "$ROUTE_CIDR" -exist
	save_rules
	log_success "路由添加完成: $CLIENT_NAME -> $ROUTE_CIDR"
}

# 删除指定用户的 CCD 路由和运行时 ipset 规则。
delete_route_for_user() {
	local user=$1 temp
	normalize_user "$user"
	[[ -f $CLIENT_CCD ]] || fail "找不到用户 CCD: $CLIENT_NAME"
	log_info "删除用户 $CLIENT_NAME 的路由: $ROUTE_CIDR"
	if ! grep -Fxq "$ROUTE_LINE" "$CLIENT_CCD"; then
		log_info "CCD 中不存在该路由，将继续清理可能残留的 ipset 规则"
	fi
	temp=$(mktemp "${CLIENT_CCD}.XXXXXX")
	grep -Fvx "$ROUTE_LINE" "$CLIENT_CCD" >"$temp" || true
	mv "$temp" "$CLIENT_CCD"
	chmod 600 "$CLIENT_CCD"
	chown 65534:65534 "$CLIENT_CCD" 2>/dev/null || true
	require_running
	docker exec "$CONTAINER_NAME" ipset del "$IPSET_NAME" "$ROUTE_CIDR" 2>/dev/null || true
	save_rules
	log_success "路由删除完成: $CLIENT_NAME -> $ROUTE_CIDR"
}

# 解析域名文件或逗号分隔参数，经确认后为单个或全部用户批量添加 IPv4 路由。
add_domain_routes() {
	local scope=${1:-user} domain_source confirm_option domain_input source_description
	local scope_description summary_label completion_prefix partial_prefix
	local raw_line domain resolved_output ip route_line existing answer index target target_ccd
	local resolved_count=0 pending_count=0 duplicate_count=0 failed_count=0 success_count=0
	local -a target_users=() resolved_domains=() resolved_route_ips=()
	local -a pending_users=() pending_domains=() pending_ips=()
	local -a duplicate_users=() duplicate_domains=() duplicate_ips=()

	case $scope in
	user)
		domain_source=$ARGUMENT
		confirm_option=$OPTION
		;;
	all)
		domain_source=$USER_INPUT
		confirm_option=$ARGUMENT
		[[ -z $OPTION ]] || fail "不支持的选项: $OPTION"
		;;
	*) fail "不支持的域名路由作用域: $scope" ;;
	esac

	[[ -n $domain_source ]] || fail "缺少域名列表文件或域名参数"
	[[ -z $confirm_option || $confirm_option == --yes ]] || fail "不支持的选项: $confirm_option"
	if [[ -e $domain_source ]]; then
		[[ -f $domain_source && -r $domain_source ]] || fail "找不到可读的域名列表文件: $domain_source"
		domain_input=$(<"$domain_source")
		source_description="域名文件"
	else
		[[ $domain_source != */* ]] || fail "找不到可读的域名列表文件: $domain_source"
		domain_input=${domain_source//,/$'\n'}
		source_description="域名参数"
	fi
	if ! command -v getent >/dev/null 2>&1 && ! command -v dig >/dev/null 2>&1 && ! command -v nslookup >/dev/null 2>&1; then
		fail "未找到域名解析命令，请安装 getent、dig 或 nslookup"
	fi

	if [[ $scope == user ]]; then
		normalize_user "$USER_INPUT"
		[[ -f $CLIENT_CCD ]] || fail "找不到用户 CCD: $CLIENT_NAME"
		target_users+=("$CLIENT_NAME")
		scope_description=$CLIENT_NAME
		summary_label="待添加 IPv4"
		completion_prefix="域名路由添加完成: $CLIENT_NAME"
		partial_prefix="域名路由部分完成: $CLIENT_NAME"
	else
		for target_ccd in "$CCD_DIR"/*; do
			[[ -f $target_ccd ]] || continue
			target_users+=("$(basename "$target_ccd")")
		done
		((${#target_users[@]} > 0)) || fail "环境 $ENV_NAME 中没有 CCD 用户"
		scope_description="环境 $ENV_NAME 的全部用户"
		summary_label="待添加用户路由"
		completion_prefix="全部用户域名路由添加完成: $ENV_NAME"
		partial_prefix="全部用户域名路由部分完成: $ENV_NAME"
	fi
	require_running
	log_start "解析域名路由: $scope_description"

	while IFS= read -r raw_line || [[ -n $raw_line ]]; do
		domain=${raw_line%%#*}
		domain=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$domain")
		[[ -n $domain ]] || continue
		if ! valid_domain "$domain"; then
			log_info "跳过无效域名: $domain"
			failed_count=$((failed_count + 1))
			continue
		fi

		log_info "解析域名: $domain"
		resolved_output=$(resolve_domain_ipv4 "$domain")
		if [[ -z $resolved_output ]]; then
			log_info "域名未解析到 IPv4 地址: $domain"
			failed_count=$((failed_count + 1))
			continue
		fi
		resolved_count=$((resolved_count + 1))

		while IFS= read -r ip; do
			[[ -n $ip ]] || continue
			existing=false
			for index in "${!resolved_route_ips[@]}"; do
				if [[ ${resolved_route_ips[$index]} == "$ip" ]]; then
					existing=true
					break
				fi
			done
			if $existing; then
				for target in "${target_users[@]}"; do
					duplicate_users+=("$target")
					duplicate_domains+=("$domain")
					duplicate_ips+=("$ip")
					duplicate_count=$((duplicate_count + 1))
				done
				continue
			fi
			resolved_domains+=("$domain")
			resolved_route_ips+=("$ip")
		done <<<"$resolved_output"
	done <<<"$domain_input"

	for index in "${!resolved_route_ips[@]}"; do
		ip=${resolved_route_ips[$index]}
		domain=${resolved_domains[$index]}
		route_line="push \"route $ip 255.255.255.255\""
		for target in "${target_users[@]}"; do
			target_ccd="$CCD_DIR/$target"
			if grep -Fxq "$route_line" "$target_ccd"; then
				duplicate_users+=("$target")
				duplicate_domains+=("$domain")
				duplicate_ips+=("$ip")
				duplicate_count=$((duplicate_count + 1))
			else
				pending_users+=("$target")
				pending_domains+=("$domain")
				pending_ips+=("$ip")
				pending_count=$((pending_count + 1))
			fi
		done
	done

	if ((pending_count > 0)); then
		log_info "待添加路由:"
		for index in "${!pending_ips[@]}"; do
			if [[ $scope == all ]]; then
				log_info "  ${pending_users[$index]}: ${pending_domains[$index]} -> ${pending_ips[$index]}/32"
			else
				log_info "  ${pending_domains[$index]} -> ${pending_ips[$index]}"
			fi
		done
	fi
	if ((duplicate_count > 0)); then
		log_info "重复路由:"
		for index in "${!duplicate_ips[@]}"; do
			if [[ $scope == all ]]; then
				log_info "  ${duplicate_users[$index]}: ${duplicate_domains[$index]} -> ${duplicate_ips[$index]}/32"
			else
				log_info "  ${duplicate_domains[$index]} -> ${duplicate_ips[$index]}/32"
			fi
		done
	fi
	log_info "汇总: 解析域名 $resolved_count 个，${summary_label} $pending_count 个，重复 $duplicate_count 个，失败 $failed_count 个"
	if ((pending_count == 0)); then
		if ((failed_count > 0 || duplicate_count == 0)); then
			fail "${source_description}中没有可添加的 IPv4 路由（解析失败: ${failed_count}）"
		fi
		log_success "$completion_prefix，成功 0 个，重复 $duplicate_count 个"
		return 0
	fi

	if [[ $confirm_option != --yes ]]; then
		printf '是否继续添加以上路由? [y/N]: ' >&2
		read -r answer || answer=""
		case $answer in
		y | Y | yes | YES | Yes) ;;
		*)
			log_info "已取消域名路由添加"
			return 0
			;;
		esac
	fi

	for index in "${!pending_ips[@]}"; do
		normalize_route "${pending_ips[$index]}"
		add_route_for_user "${pending_users[$index]}"
		success_count=$((success_count + 1))
	done
	if ((failed_count > 0)); then
		fail "$partial_prefix，成功 $success_count 个，失败 $failed_count 个"
	fi
	log_success "$completion_prefix，成功 $success_count 个，重复 $duplicate_count 个"
}

# 列出用户 CCD 中的静态路由和容器内的 ipset 路由。
list_routes() {
	normalize_user "$USER_INPUT"
	[[ -f $CLIENT_CCD ]] || fail "找不到用户 CCD: $CLIENT_NAME"
	log_info "查看用户 $CLIENT_NAME 的 CCD 和 ipset 路由"
	grep '^push "route ' "$CLIENT_CCD" || true
	if container_running; then
		docker exec "$CONTAINER_NAME" ipset list "$IPSET_NAME"
	else
		log_info "容器未运行，仅显示 CCD 路由"
	fi
}

# 为当前环境全部 CCD 用户批量添加或删除指定路由。
route_all() {
	local action=$1 ccd user count=0 action_name
	normalize_route "$USER_INPUT"
	if [[ $action == add ]]; then action_name=添加; else action_name=删除; fi
	log_start "为环境 $ENV_NAME 的全部用户${action_name}路由: $ROUTE_CIDR"
	for ccd in "$CCD_DIR"/*; do
		[[ -f $ccd ]] || continue
		user=$(basename "$ccd")
		count=$((count + 1))
		if [[ $action == add ]]; then
			add_route_for_user "$user"
		else
			delete_route_for_user "$user"
		fi
	done
	log_success "批量路由操作完成: ${action_name} ${ROUTE_CIDR}，共处理 $count 个用户"
}

# 查询并格式化输出用户当前绑定的设备信息。
list_hardware() {
	normalize_user "$USER_INPUT"
	log_info "查看用户 $CLIENT_NAME 的设备绑定信息"
	record=$(awk -F', ' -v user="$CLIENT_NAME" '$1 == user { print; exit }' "$CLIENT_DB")
	[[ -n $record ]] || fail "找不到用户状态记录: $CLIENT_NAME"
	awk -F', ' '{
        print "CLIENT NAME: " $1
        print "CLIENT IP: " $2
        print "SYSTEM PLATFORM: " $3
        print "SYSTEM VERSION: " $4
        print "SYSTEM USER: " $5
        print "DEVICE ID: " $6
        print "DISK ID: " $7
        print "LAST LOGIN: " $8
    }' <<<"$record"
}

# 清空用户设备绑定字段，使其可在下次连接时重新绑定。
delete_hardware() {
	normalize_user "$USER_INPUT"
	if ! awk -F', ' -v user="$CLIENT_NAME" '$1 == user { found = 1 } END { exit found ? 0 : 1 }' "$CLIENT_DB"; then
		fail "找不到用户状态记录: $CLIENT_NAME"
	fi
	log_start "清空用户设备绑定: ${CLIENT_NAME}（环境: ${ENV_NAME}）"
	temp=$(mktemp "${CLIENT_DB}.XXXXXX")
	awk -F', ' -v OFS=', ' -v user="$CLIENT_NAME" \
		'$1 == user { $3=""; $4=""; $5=""; $6=""; $7="" } { print }' "$CLIENT_DB" >"$temp"
	mv "$temp" "$CLIENT_DB"
	chown 65534:65534 "$CLIENT_DB" 2>/dev/null || true
	log_success "设备绑定已清空: $CLIENT_NAME"
	list_hardware
}

# 从运行目录备份恢复容器内的 iptables 规则。
reload_iptables() {
	require_running
	[[ -r $IPTABLES_BACKUP ]] || fail "找不到可读的 iptables 规则备份: $IPTABLES_BACKUP"
	log_start "恢复 iptables 规则: $CONTAINER_NAME"
	log_info "规则备份: $IPTABLES_BACKUP"
	docker exec "$CONTAINER_NAME" sh -c 'iptables-restore < "$1/state/iptables.rules"' sh "$OPENVPN"
	log_success "iptables 规则恢复完成"
}

# 从运行目录备份恢复容器内的 ipset 规则。
reload_ipset() {
	require_running
	[[ -r $IPSET_BACKUP ]] || fail "找不到可读的 ipset 规则备份: $IPSET_BACKUP"
	log_start "恢复 ipset 规则: $CONTAINER_NAME"
	log_info "规则备份: $IPSET_BACKUP"
	docker exec "$CONTAINER_NAME" sh -c 'ipset restore -exist < "$1/state/ipset.rules"' sh "$OPENVPN"
	log_success "ipset 规则恢复完成"
}

